@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<section class="k-message">
    <h1 class="h3">Something went wrong on our side.</h1>
    <p class="text-body-secondary">Try again. If it keeps happening, tell the school admin.</p>
    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary">Go to my home page</a>
    @if (Model.ShowRequestId)
    {
        <p class="small text-body-secondary mt-4 mb-0">Reference: <span class="font-monospace">@Model.RequestId</span></p>
    }
</section>
