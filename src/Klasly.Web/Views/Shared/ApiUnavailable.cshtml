@{
    ViewData["Title"] = "Server unavailable";
}

<section class="py-5">
    <h1 class="h3">Klasly can't reach the server right now.</h1>
    <p class="text-body-secondary">Try again in a minute. If it keeps happening, check that the Klasly Web API is running.</p>
    <a href="" class="btn btn-outline-primary" onclick="location.reload(); return false;">Try again</a>
</section>
