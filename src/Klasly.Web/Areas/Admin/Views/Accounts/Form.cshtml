@model AccountFormViewModel
@{
    var isNew = Model.Id is null;
    var role = Model.Role.ToLowerInvariant();
    ViewData["Title"] = isNew ? $"New {role}" : $"Edit {role}: {Model.FullName}";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Accounts</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-route-role="@Model.Role">@(Model.Role)s</a></li>
        <li class="breadcrumb-item active" aria-current="page">@(isNew ? $"New {role}" : Model.FullName)</li>
    </ol>
</nav>

<h1 class="h3 mb-4">@ViewData["Title"]</h1>

@* data-warn-unsaved: on a parent's page, Link/Unlink below reload the page, so typed edits here would be lost without a warning. *@
<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post" class="col-12 col-md-8 col-lg-6" data-warn-unsaved>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <input type="hidden" asp-for="Role" />

    <fieldset class="mb-4">
        <legend class="h6">Login</legend>
        <div class="mb-3">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" autocomplete="off" />
            <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="off" />
            <span asp-validation-for="Email" class="text-danger small"></span>
            <div class="form-text">Used to log in.</div>
        </div>

        @if (isNew)
        {
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
                <div class="form-text">At least 8 characters. Give it to the user privately.</div>
            </div>
        }
        else
        {
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                <div class="form-text">Leave blank to keep the current password.</div>
            </div>
        }
    </fieldset>

    @if (Model.Role is "Student" or "Teacher" or "Parent")
    {
        <fieldset class="mb-4">
            <legend class="h6">@Model.Role details</legend>
            @if (Model.Role == "Student")
            {
                <div class="row">
                    <div class="col-sm-6 mb-3">
                        <label asp-for="StudentNumber" class="form-label"></label>
                        <input asp-for="StudentNumber" class="form-control" placeholder="2026-00007" />
                        <span asp-validation-for="StudentNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <label asp-for="YearLevel" class="form-label"></label>
                        <input asp-for="YearLevel" class="form-control" min="1" max="6" />
                        <span asp-validation-for="YearLevel" class="text-danger small"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Program" class="form-label"></label>
                    <input asp-for="Program" class="form-control" placeholder="BSCpE" />
                    <span asp-validation-for="Program" class="text-danger small"></span>
                </div>
            }
            else if (Model.Role == "Teacher")
            {
                <div class="row">
                    <div class="col-sm-6 mb-3">
                        <label asp-for="EmployeeNo" class="form-label"></label>
                        <input asp-for="EmployeeNo" class="form-control" />
                        <span asp-validation-for="EmployeeNo" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <label asp-for="Department" class="form-label"></label>
                        <input asp-for="Department" class="form-control" />
                        <span asp-validation-for="Department" class="text-danger small"></span>
                    </div>
                </div>
            }
            else
            {
                <div class="row">
                    <div class="col-sm-6 mb-3">
                        <label asp-for="ContactEmail" class="form-label"></label>
                        <input asp-for="ContactEmail" class="form-control" />
                        <span asp-validation-for="ContactEmail" class="text-danger small"></span>
                        <div class="form-text">Alerts go here. Leave blank to use the login email.</div>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <label asp-for="ContactNumber" class="form-label"></label>
                        <input asp-for="ContactNumber" class="form-control" placeholder="+639170000000" />
                        <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                    </div>
                </div>
            }
        </fieldset>
    }

    @if (!isNew)
    {
        <fieldset class="mb-4">
            <legend class="h6">Status</legend>
            <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" aria-describedby="active-help" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
            <div id="active-help" class="form-text">Turn off to stop this user logging in. Turn on again to let them back in.</div>
        </fieldset>
    }

    <div class="d-grid d-sm-flex gap-2">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" asp-route-role="@Model.Role" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@if (Model.ParentLinks is { } links)
{
    <partial name="_ParentLinks" model="links" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
