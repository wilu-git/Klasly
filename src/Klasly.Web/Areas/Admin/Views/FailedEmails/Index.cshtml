@using Klasly.Web.Infrastructure
@model List<FailedEmailResponse>
@{
    ViewData["Title"] = "Failed emails";
}

<div class="mb-4">
    <h1 class="h3 mb-1">Failed emails</h1>
    <p class="text-body-secondary mb-0">
        Parent alerts that the email service refused or that ran out of retries.
        Check the address in <a asp-controller="Accounts" asp-action="Index" asp-route-role="Parent">parent accounts</a>; new alerts are sent as usual.
    </p>
</div>

@if (Model.Count == 0)
{
    <p class="text-body-secondary">No failed emails. Every alert reached the email service.</p>
}
else
{
    @* Every column matters here, so on phones the table scrolls inside its box instead of hiding columns. *@
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Created</th>
                    <th scope="col">Recipient</th>
                    <th scope="col">Alert</th>
                    <th scope="col" class="text-end">Attempts</th>
                    <th scope="col">Last error</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var email in Model)
                {
                    <tr>
                        <td class="text-nowrap">@ManilaTime.Format(email.CreatedAtUtc)</td>
                        <td>
                            <div>@email.RecipientName</div>
                            <div class="small text-body-secondary">@email.RecipientEmail</div>
                        </td>
                        <td class="cell-readable">
                            <div>@(email.Type == "AtRisk" ? "At risk" : email.Type)</div>
                            <div class="small text-body-secondary">@email.Subject</div>
                        </td>
                        <td class="text-end">@email.Attempts</td>
                        <td class="small text-break cell-readable">@(email.LastError ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Count == 100)
    {
        <p class="small text-body-secondary mt-2">Showing the newest 100.</p>
    }
}
