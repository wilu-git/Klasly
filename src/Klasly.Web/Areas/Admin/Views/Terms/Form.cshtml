@model TermFormViewModel
@{
    var isNew = Model.Id is null;
    ViewData["Title"] = isNew ? "New term" : "Edit term";
}

<h1 class="h3 mb-4">@ViewData["Title"]</h1>

<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post" class="col-12 col-md-8 col-lg-6">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" placeholder="1st Sem 2026-27" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="row">
        <div class="col-sm-6 mb-3">
            <label asp-for="StartDate" class="form-label"></label>
            <input asp-for="StartDate" class="form-control" />
            <span asp-validation-for="StartDate" class="text-danger small"></span>
        </div>
        <div class="col-sm-6 mb-3">
            <label asp-for="EndDate" class="form-label"></label>
            <input asp-for="EndDate" class="form-control" />
            <span asp-validation-for="EndDate" class="text-danger small"></span>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
