@model List<SubjectResponse>
@{
    ViewData["Title"] = "Subjects";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="h3 mb-0">Subjects</h1>
    <a asp-action="Create" class="btn btn-primary">New subject</a>
</div>

@if (Model.Count == 0)
{
    <p class="text-body-secondary">No subjects yet. Add the first subject to the catalog.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Code</th>
                    <th scope="col">Title</th>
                    <th scope="col" class="text-end d-none d-sm-table-cell">Units</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var subject in Model)
                {
                    <tr>
                        <td class="fw-semibold text-nowrap">@subject.Code</td>
                        <td>@subject.Title<span class="d-block d-sm-none small text-body-secondary">@subject.Units @(subject.Units == 1 ? "unit" : "units")</span></td>
                        <td class="text-end d-none d-sm-table-cell">@subject.Units</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@subject.SubjectId" class="btn btn-sm btn-outline-secondary">Edit<span class="visually-hidden"> @subject.Code</span></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
