@model List<SubjectResponse>
@{
    ViewData["Title"] = "Subjects";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Subjects</h1>
    <a asp-action="Create" class="btn btn-primary">New subject</a>
</div>

@if (Model.Count == 0)
{
    <p class="text-body-secondary">No subjects yet. Add the first subject to the catalog.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Code</th>
                    <th scope="col">Title</th>
                    <th scope="col" class="text-end">Units</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var subject in Model)
                {
                    <tr>
                        <td class="fw-semibold">@subject.Code</td>
                        <td>@subject.Title</td>
                        <td class="text-end">@subject.Units</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@subject.SubjectId" class="btn btn-sm btn-outline-secondary">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
