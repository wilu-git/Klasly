@model ClassDetailsViewModel
@{
    var c = Model.Class;
    ViewData["Title"] = $"{c.SubjectCode} – {c.Section}";
    // Active students first; dropped ones are grouped below so the current roster reads cleanly.
    var active = Model.Enrollments.Where(e => e.Status == "Active").ToList();
    var dropped = Model.Enrollments.Where(e => e.Status != "Active").ToList();
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index" asp-route-termId="@c.TermId">Classes</a></li>
        <li class="breadcrumb-item active" aria-current="page">@c.SubjectCode – @c.Section</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-4">
    <div>
        <h1 class="h3 mb-1">@c.SubjectCode @c.SubjectTitle – @c.Section</h1>
        <p class="text-body-secondary mb-0">
            @c.TeacherName · @c.TermName@(c.Schedule is null ? "" : $" · {c.Schedule}")@(c.Room is null ? "" : $" · {c.Room}")
        </p>
    </div>
    <a asp-action="Edit" asp-route-id="@c.ClassId" class="btn btn-outline-secondary">Edit class</a>
</div>

@* Enrolling is the main task here, so the form comes before the roster. *@
<section class="k-panel mb-4" aria-labelledby="enroll-heading">
    <h2 id="enroll-heading" class="h6">Enroll a student</h2>
    @if (Model.StudentOptions.Count == 0)
    {
        <p class="text-body-secondary mb-0">Every active student is already enrolled in this class.</p>
    }
    else
    {
        <form asp-action="Enroll" asp-route-id="@c.ClassId" method="post" class="row g-2 align-items-end">
            <div class="col-12 col-md-8 col-lg-6">
                <label for="studentId" class="form-label">Student</label>
                <select id="studentId" name="studentId" class="form-select" asp-items="Model.StudentOptions" required>
                    <option value="">Choose a student…</option>
                </select>
            </div>
            <div class="col-12 col-md-auto">
                <button type="submit" class="btn btn-outline-primary w-100" data-pending-text="Enrolling…">Enroll</button>
            </div>
        </form>
    }
</section>

<h2 class="h5">Students <span class="text-body-secondary fw-normal">(@c.ActiveEnrollmentCount enrolled)</span></h2>

@if (Model.Enrollments.Count == 0)
{
    <p class="text-body-secondary">No students enrolled yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col" class="d-none d-sm-table-cell">Student no.</th>
                    <th scope="col">Name</th>
                    <th scope="col">Status</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in active)
                {
                    <tr>
                        <td class="d-none d-sm-table-cell text-nowrap">@e.StudentNumber</td>
                        <td>@e.StudentName<span class="d-block d-sm-none small text-body-secondary">@e.StudentNumber</span></td>
                        <td><partial name="_StatusBadge" model='(e.Status, "success")' /></td>
                        <td class="text-end">
                            <form asp-action="Drop" asp-route-id="@c.ClassId" asp-route-enrollmentId="@e.EnrollmentId" method="post" class="d-inline"
                                  data-confirm="Drop @e.StudentName from @c.SubjectCode – @c.Section?">
                                <button type="submit" class="btn btn-sm btn-link link-danger">Drop<span class="visually-hidden"> @e.StudentName</span></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (dropped.Count > 0)
                {
                    <tr>
                        <th scope="rowgroup" colspan="4" class="text-body-secondary small fw-semibold pt-3">Dropped (@dropped.Count)</th>
                    </tr>
                    @foreach (var e in dropped)
                    {
                        <tr class="text-body-secondary">
                            <td class="d-none d-sm-table-cell text-nowrap">@e.StudentNumber</td>
                            <td>@e.StudentName<span class="d-block d-sm-none small">@e.StudentNumber</span></td>
                            <td><partial name="_StatusBadge" model='(e.Status, "secondary")' /></td>
                            <td></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}
