@model ClassListViewModel
@{
    ViewData["Title"] = "Classes";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Classes</h1>
    <a asp-action="Create" class="btn btn-primary">New class</a>
</div>

<form asp-action="Index" method="get" class="d-flex flex-wrap align-items-end gap-2 mb-3">
    <div>
        <label for="termId" class="form-label small mb-1">Term</label>
        <select id="termId" name="termId" class="form-select" asp-items="Model.TermOptions"></select>
    </div>
    <button type="submit" class="btn btn-outline-secondary">Show</button>
</form>

@if (Model.Classes.Count == 0)
{
    <p class="text-body-secondary">No classes in this term yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Subject</th>
                    <th scope="col">Section</th>
                    <th scope="col">Teacher</th>
                    <th scope="col">Schedule</th>
                    <th scope="col">Room</th>
                    <th scope="col" class="text-end">Enrolled</th>
                    @if (Model.SelectedTermId == 0)
                    {
                        <th scope="col">Term</th>
                    }
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Classes)
                {
                    <tr>
                        <td><span class="fw-semibold">@c.SubjectCode</span> <span class="text-body-secondary">@c.SubjectTitle</span></td>
                        <td>@c.Section</td>
                        <td>@c.TeacherName</td>
                        <td>@(c.Schedule ?? "—")</td>
                        <td>@(c.Room ?? "—")</td>
                        <td class="text-end">@c.ActiveEnrollmentCount</td>
                        @if (Model.SelectedTermId == 0)
                        {
                            <td>@c.TermName</td>
                        }
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@c.ClassId" class="btn btn-sm btn-outline-primary">Students</a>
                            <a asp-action="Edit" asp-route-id="@c.ClassId" class="btn btn-sm btn-outline-secondary">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
