@model AssessmentPageViewModel
@{
    var a = Model.Assessment;
    var c = Model.Class;
    var max = a.MaxScore.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    ViewData["Title"] = $"{a.Title} – {c.SubjectCode} {c.Section}";
    // Open the edit form when it came back with errors, so the teacher sees them.
    var editHasErrors = new[] { "Title", "Type", "MaxScore", "WeightPercent" }
        .Any(k => ViewData.ModelState.TryGetValue(k, out var entry) && entry.Errors.Count > 0);
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Classes" asp-action="Index">My classes</a></li>
        <li class="breadcrumb-item"><a asp-controller="Classes" asp-action="Details" asp-route-id="@c.ClassId" asp-fragment="assessments">@c.SubjectCode – @c.Section</a></li>
        <li class="breadcrumb-item active" aria-current="page">@a.Title</li>
    </ol>
</nav>

<div class="mb-4">
    <h1 class="h3 mb-1">@a.Title</h1>
    <p class="text-body-secondary mb-0">@a.Type · @max points · @a.WeightPercent.ToString("0.##")% of the grade</p>
</div>

<h2 class="h5">Grades</h2>
<p class="mb-3">Leave a score blank if it isn't graded yet.</p>

@if (Model.Grades.Count == 0)
{
    <p class="text-body-secondary">No students are enrolled in this class.</p>
}
else
{
    @* data-warn-unsaved: site.js asks before leaving with typed, unsaved scores. *@
    <form asp-action="SaveGrades" asp-route-id="@a.AssessmentId" method="post" data-warn-unsaved id="grade-form">
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th scope="col" class="d-none d-md-table-cell text-nowrap">Student no.</th>
                        <th scope="col">Name</th>
                        <th scope="col" class="text-nowrap">Score (0–@max)</th>
                        <th scope="col" class="d-none d-sm-table-cell text-nowrap">Last saved (Manila)</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Grades.Count; i++)
                    {
                        var g = Model.Grades[i];
                        <tr>
                            <td class="d-none d-md-table-cell text-nowrap">@g.StudentNumber</td>
                            <td>
                                @g.FullName
                                @Html.ValidationMessage($"Grades[{i}].StudentId", new { @class = "d-block text-danger small" })
                            </td>
                            <td>
                                <input type="hidden" asp-for="Grades[i].StudentId" />
                                <label class="visually-hidden" asp-for="Grades[i].Score">Score for @g.FullName</label>
                                <div class="d-flex align-items-center gap-2">
                                    <input asp-for="Grades[i].Score" asp-format="{0:0.##}" type="number" step="0.01" min="0" max="@max"
                                           class="form-control form-control-sm score-input" />
                                    <span class="text-body-secondary small text-nowrap">/ @max</span>
                                </div>
                                <span asp-validation-for="Grades[i].Score" class="text-danger small"></span>
                            </td>
                            <td class="d-none d-sm-table-cell text-nowrap">@(g.LastSavedUtc is { } at ? ManilaTime.Format(at) : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @Html.ValidationMessage("grades", new { @class = "d-block text-danger mt-2" })
        @* Sticky so Save is always reachable on a long class list; the count updates as scores are typed. *@
        <div class="k-savebar">
            <span><strong class="num" id="graded-count">@Model.Graded</strong> of @Model.Grades.Count graded</span>
            <button type="submit" class="btn btn-primary" data-pending-text="Saving grades…">Save grades</button>
        </div>
    </form>
}

<details class="card mt-5 mb-4" @(editHasErrors ? "open" : "")>
    <summary class="card-header">Edit assessment</summary>
    <div class="card-body">
        <p class="text-body-secondary small">The class weights can't go above 100% in total, and the max score can't be lower than a score already saved.</p>
        <partial name="_AssessmentForm" model="Model.Edit" />
    </div>
</details>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Live "N of M graded": counts score boxes that aren't blank (saved or just typed).
        (() => {
            const form = document.getElementById('grade-form');
            const count = document.getElementById('graded-count');
            if (!form || !count) return;
            form.addEventListener('input', () => {
                count.textContent = [...form.querySelectorAll('.score-input')].filter(i => i.value.trim() !== '').length;
            });
        })();
    </script>
}
