@model SessionLiveViewModel
@* Swapped into #live-panel every 5 s while the session is open. data-closed tells the page script to stop polling. *@
@* Keep exactly one root element: the page script reads panel.firstElementChild.dataset. *@
@* Once the session has ended there is no QR, so the roster takes the full width (it has the Correct column then). *@
<div class="row g-4" data-closed="@(Model.IsClosed ? "true" : "false")" data-summary="@(Model.IsClosed ? "This session has ended. " : "")@Model.Summary">
    <div class="@(Model.IsClosed ? "col-12" : "col-12 col-lg-5")">
        @if (Model.QrSvg is not null)
        {
            <h2 class="visually-hidden">Check-in QR code</h2>
            <div class="qr-code" role="img" aria-label="Check-in QR code. Students scan it with the Klasly app.">@Html.Raw(Model.QrSvg)</div>
            <p class="text-body-secondary small text-center mt-2 mb-0">Changes every 30 s</p>
        }
        else
        {
            <div class="alert alert-secondary mb-0">
                This session has ended. Students can no longer check in.
                @if (Model.CanCorrect)
                {
                    <text>To fix a result, choose a new status in the <strong>Correct</strong> column and press Save.</text>
                }
            </div>
        }
    </div>

    <div class="@(Model.IsClosed ? "col-12" : "col-12 col-lg-7")">
        <h2 class="visually-hidden">Attendance</h2>
        @* The checked-in count is the number a teacher glances at from the front of the room; the breakdown is secondary. *@
        <p class="mb-1"><span class="k-count num">@Model.CheckedIn<span class="k-count-total"> / @Model.Roster.Count</span></span> <span class="fw-semibold">checked in</span></p>
        <p class="text-body-secondary small mb-3 num">@Model.Present Present · @Model.Late Late@(Model.IsClosed ? $" · {Model.Absent} Absent · {Model.Excused} Excused" : "")</p>

        @if (Model.Roster.Count == 0)
        {
            <p class="text-body-secondary">No students are enrolled in this class.</p>
        }
        else
        {
            @* On phones the student no. and scan time are hidden and the source moves under the status, so Correct stays on screen. *@
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th scope="col" class="d-none d-md-table-cell text-nowrap">Student no.</th>
                            <th scope="col">Name</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="d-none d-md-table-cell text-nowrap">Scanned (Manila)</th>
                            <th scope="col" class="d-none d-sm-table-cell">Source</th>
                            @if (Model.CanCorrect)
                            {
                                <th scope="col">Correct</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Roster)
                        {
                            var variant = r.Status switch
                            {
                                "Present" => "success",
                                "Late" => "warning",
                                "Absent" => "danger",
                                "Excused" => "info",
                                _ => "secondary" // not scanned yet
                            };
                            var label = r.Status ?? "Not yet";
                            var source = r.Source switch { "Scan" => "Scan", "Auto" => "Auto", "Manual" => "Corrected", _ => "—" };
                            @* id lets a correction redirect land back on this row (SessionsController.Correct). *@
                            <tr id="row-@r.StudentId">
                                <td class="d-none d-md-table-cell text-nowrap">@r.StudentNumber</td>
                                <td>@r.FullName</td>
                                <td>
                                    <partial name="_StatusBadge" model="(label, variant)" />
                                    @if (r.Source is not null)
                                    {
                                        <span class="d-block d-sm-none small text-body-secondary">@source</span>
                                    }
                                </td>
                                <td class="d-none d-md-table-cell text-nowrap">@(r.ScannedAtUtc is { } at ? ManilaTime.FormatTime(at) : "—")</td>
                                <td class="d-none d-sm-table-cell">@source</td>
                                @if (Model.CanCorrect)
                                {
                                    <td>
                                        <form asp-action="Correct" asp-route-id="@Model.SessionId" asp-route-studentId="@r.StudentId"
                                              method="post" class="d-flex flex-wrap gap-2 m-0">
                                            @* Lets the controller say "no change" instead of a false "updated". *@
                                            <input type="hidden" name="currentStatus" value="@r.Status" />
                                            <label class="visually-hidden" for="status-@r.StudentId">New status for @r.FullName</label>
                                            <select id="status-@r.StudentId" name="status" class="form-select form-select-sm w-auto">
                                                @if (r.Status is null)
                                                {
                                                    <option value="" selected disabled>Choose…</option>
                                                }
                                                @foreach (var option in SessionLiveViewModel.Statuses)
                                                {
                                                    <option selected="@(option == r.Status)">@option</option>
                                                }
                                            </select>
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Save<span class="visually-hidden"> for @r.FullName</span></button>
                                        </form>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
