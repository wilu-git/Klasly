@model SessionPageViewModel
@{
    var s = Model.Session;
    var day = ManilaTime.ToLocal(s.StartTimeUtc).ToString("ddd, MMM d", System.Globalization.CultureInfo.InvariantCulture);
    ViewData["Title"] = $"{s.SubjectCode} – {s.Section}, {day}";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Classes" asp-action="Index">My classes</a></li>
        <li class="breadcrumb-item"><a asp-controller="Classes" asp-action="Details" asp-route-id="@s.ClassId">@s.SubjectCode – @s.Section</a></li>
        <li class="breadcrumb-item active" aria-current="page">@day</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">@s.SubjectCode – @s.Section <partial name="_SessionStatusBadge" model="s" /></h1>
        <p class="text-body-secondary mb-0">
            @day · @ManilaTime.FormatTime(s.StartTimeUtc) – @ManilaTime.FormatTime(s.EndTimeUtc) (Manila) · Late after @s.LateAfterMinutes min
        </p>
    </div>
    @if (s.Status == "Scheduled")
    {
        <form asp-action="Open" asp-route-id="@s.SessionId" method="post" class="m-0">
            <button type="submit" class="btn btn-primary">Open session</button>
        </form>
    }
    else if (s.Status == "Open")
    {
        @* Kept away from the QR so it isn't clicked by accident. *@
        <form asp-action="Close" asp-route-id="@s.SessionId" method="post" class="m-0"
              data-confirm="End this session? Students who haven't scanned can no longer check in.">
            <button type="submit" class="btn btn-outline-danger">End session</button>
        </form>
    }
</div>

@if (Model.Live is null && s.Status == "Cancelled")
{
    <div class="alert alert-secondary">This session was never opened, so no attendance was taken.</div>
}
else if (Model.Live is null)
{
    <p class="text-body-secondary">This session hasn't been opened yet. Open it to show the QR code.</p>
}
else
{
    @if (s.Status == "Open" && !s.IsLive)
    {
        @* Past its end time but still open: corrections only appear once it's closed (End session, or the Worker within ~5 min). *@
        <p class="alert alert-info py-2">Press <strong>End session</strong> to close it and correct results.</p>
    }
    <p id="live-status" class="alert alert-warning py-2" role="status" hidden>Reconnecting… The QR and list below may be out of date.</p>
    <p id="live-announcer" class="visually-hidden" aria-live="polite"></p>
    <div id="live-panel">
        <partial name="_Live" model="Model.Live" />
    </div>
}

@if (s.IsLive)
{
    @section Scripts {
        <script>
            // Every 5 s, swap in the fresh QR + roster from the Live action (same site; the JWT stays in the cookie).
            (() => {
                const panel = document.getElementById('live-panel');
                const status = document.getElementById('live-status');
                const announcer = document.getElementById('live-announcer');
                const url = '@Url.Action("Live", new { id = s.SessionId })';

                // The next poll starts 5 s after this one ends, so a slow API never piles up requests.
                async function poll() {
                    try {
                        const res = await fetch(url, { redirect: 'manual', cache: 'no-store' });
                        // Login expired or access lost: reload the page itself, so the normal redirect (with its message) happens.
                        if (res.type === 'opaqueredirect') { location.reload(); return; }
                        if (!res.ok) throw new Error(res.status);
                        panel.innerHTML = await res.text();
                        status.hidden = true;
                        const root = panel.firstElementChild;
                        if (announcer.textContent !== root.dataset.summary) announcer.textContent = root.dataset.summary;
                        // Closed or past its end: reload once to show the final state; that page has no poller.
                        if (root.dataset.closed === 'true') { setTimeout(() => location.reload(), 3000); return; }
                    } catch {
                        status.hidden = false; // API down or network error: keep the last QR and roster, try again
                    }
                    setTimeout(poll, 5000);
                }
                setTimeout(poll, 5000);
            })();
        </script>
    }
}
