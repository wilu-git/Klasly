@model TeacherClassViewModel
@{
    var c = Model.Class;
    ViewData["Title"] = $"{c.SubjectCode} – {c.Section}";
    // A session in progress comes first: the teacher returning mid-class needs its QR, not a second session.
    var live = Model.Sessions.FirstOrDefault(x => x.IsLive);
    var startHasErrors = new[] { "start", "EndTime", "LateAfterMinutes" }
        .Any(k => ViewData.ModelState.TryGetValue(k, out var entry) && entry.Errors.Count > 0);
    var total = Model.WeightTotal;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">My classes</a></li>
        <li class="breadcrumb-item active" aria-current="page">@c.SubjectCode – @c.Section</li>
    </ol>
</nav>

<div class="mb-4">
    <h1 class="h3 mb-1">@c.SubjectCode @c.SubjectTitle – @c.Section</h1>
    <p class="text-body-secondary mb-0">
        @c.TermName@(c.Schedule is null ? "" : $" · {c.Schedule}")@(c.Room is null ? "" : $" · {c.Room}") · @c.ActiveEnrollmentCount enrolled
    </p>
</div>

@if (live is not null)
{
    <section class="k-live mb-4" aria-labelledby="live-heading">
        <div>
            <h2 id="live-heading" class="h6 mb-1">Session in progress</h2>
            <p class="small mb-0">Started @ManilaTime.FormatTime(live.StartTimeUtc) · ends @ManilaTime.FormatTime(live.EndTimeUtc) (Manila)</p>
        </div>
        <a asp-controller="Sessions" asp-action="Details" asp-route-id="@live.SessionId" class="btn btn-primary">Show QR</a>
    </section>

    <details class="mb-4" @(startHasErrors ? "open" : "")>
        <summary class="btn btn-sm btn-outline-secondary k-summary-btn">Start another session</summary>
        <div class="mt-3">
            <partial name="_StartSession" model="Model.Start" />
        </div>
    </details>
}
else
{
    <partial name="_StartSession" model="Model.Start" />
}

<h2 class="h5 mt-5" id="assessments">Assessments</h2>

@if (Model.Assessments.Count == 0)
{
    <p class="text-body-secondary">No assessments yet. Add the first one below.</p>
}
else
{
    <p class="mb-2">
        Weights: <strong class="num">@total.ToString("0.##") of 100%</strong>@(total == 100 ? " · complete" : "")
    </p>
    @if (total < 100)
    {
        <div class="alert alert-warning py-2" role="status">
            The weights add up to @total.ToString("0.##")%. Add assessments until they reach 100%; you can enter grades before then.
        </div>
    }

    <div class="table-responsive mb-4">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Title</th>
                    <th scope="col" class="d-none d-sm-table-cell">Type</th>
                    <th scope="col" class="text-end text-nowrap">Max score</th>
                    <th scope="col" class="text-end">Weight</th>
                    <th scope="col">Graded</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Assessments)
                {
                    <tr>
                        <td>@a.Title</td>
                        <td class="d-none d-sm-table-cell">@a.Type</td>
                        <td class="text-end">@a.MaxScore.ToString("0.##")</td>
                        <td class="text-end">@a.WeightPercent.ToString("0.##")%</td>
                        <td class="text-nowrap">@a.GradedCount of @a.ActiveCount</td>
                        <td class="text-end">
                            <a asp-controller="Assessments" asp-action="Details" asp-route-id="@a.AssessmentId"
                               class="btn btn-sm btn-outline-secondary">Grades<span class="visually-hidden"> for @a.Title</span></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<section class="card mb-4" aria-labelledby="add-assessment-heading">
    <div class="card-body">
        <h3 id="add-assessment-heading" class="h6 card-title">Add an assessment</h3>
        <partial name="_AssessmentForm" model="Model.NewAssessment" />
    </div>
</section>

<h2 class="h5 mt-5">Sessions</h2>

@if (Model.Sessions.Count == 0)
{
    <p class="text-body-secondary">No sessions yet. Start one above when class begins.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Date</th>
                    <th scope="col">Time (Manila)</th>
                    <th scope="col">Status</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Sessions)
                {
                    <tr>
                        <td class="text-nowrap">@ManilaTime.ToLocal(s.StartTimeUtc).ToString("ddd, MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</td>
                        <td class="text-nowrap">@ManilaTime.FormatTime(s.StartTimeUtc) – @ManilaTime.FormatTime(s.EndTimeUtc)</td>
                        <td><partial name="_SessionStatusBadge" model="s" /></td>
                        <td class="text-end">
                            <a asp-controller="Sessions" asp-action="Details" asp-route-id="@s.SessionId"
                               class="btn btn-sm btn-outline-secondary">@(s.IsLive ? "Show QR" : "View")<span class="visually-hidden"> for @ManilaTime.ToLocal(s.StartTimeUtc).ToString("MMM d", System.Globalization.CultureInfo.InvariantCulture)</span></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
