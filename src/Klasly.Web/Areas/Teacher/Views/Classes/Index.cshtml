@model List<ClassResponse>
@{
    ViewData["Title"] = "My classes";
}

<h1 class="h3 mb-4">My classes</h1>

@if (Model.Count == 0)
{
    <p class="text-body-secondary">You have no classes yet. Ask the admin to assign you to a class.</p>
}
else
{
    @* The class name opens the class page. On phones, term/schedule/room move under the name instead of their own columns. *@
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Class</th>
                    <th scope="col" class="d-none d-md-table-cell">Term</th>
                    <th scope="col" class="d-none d-md-table-cell">Schedule</th>
                    <th scope="col" class="d-none d-md-table-cell">Room</th>
                    <th scope="col" class="text-end">Enrolled</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@c.ClassId" class="fw-semibold">@c.SubjectCode – @c.Section</a>
                            <span class="d-block small text-body-secondary">@c.SubjectTitle</span>
                            <span class="d-block d-md-none small text-body-secondary">@c.TermName@(c.Schedule is null ? "" : $" · {c.Schedule}")@(c.Room is null ? "" : $" · {c.Room}")</span>
                        </td>
                        <td class="d-none d-md-table-cell">@c.TermName</td>
                        <td class="d-none d-md-table-cell">@(c.Schedule ?? "—")</td>
                        <td class="d-none d-md-table-cell">@(c.Room ?? "—")</td>
                        <td class="text-end">@c.ActiveEnrollmentCount</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
