@model List<ClassResponse>
@{
    ViewData["Title"] = "My classes";
}

<h1 class="h3 mb-3">My classes</h1>

@if (Model.Count == 0)
{
    <p class="text-body-secondary">You have no classes yet. Ask the admin to assign you to a class.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Subject</th>
                    <th scope="col">Section</th>
                    <th scope="col">Term</th>
                    <th scope="col">Schedule</th>
                    <th scope="col">Room</th>
                    <th scope="col" class="text-end">Enrolled</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><span class="fw-semibold">@c.SubjectCode</span> <span class="text-body-secondary">@c.SubjectTitle</span></td>
                        <td>@c.Section</td>
                        <td>@c.TermName</td>
                        <td>@(c.Schedule ?? "—")</td>
                        <td>@(c.Room ?? "—")</td>
                        <td class="text-end">@c.ActiveEnrollmentCount</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@c.ClassId" class="btn btn-sm btn-outline-primary"
                               aria-label="Sessions for @c.SubjectCode @c.Section">Sessions</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
