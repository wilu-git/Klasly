@model AssessmentFormViewModel
@* One form for both pages: Add on the class page (no AssessmentId), Edit on the assessment page. *@
@{ var isNew = Model.AssessmentId is null; }
<form asp-controller="Assessments" asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@Model.AssessmentId"
      method="post" class="row g-3 align-items-start">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger col-12" role="alert"></div>
    <input type="hidden" asp-for="ClassId" />

    <div class="col-12 col-md-4">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" placeholder="e.g. Quiz 1" />
        <span asp-validation-for="Title" class="text-danger small"></span>
    </div>
    <div class="col-12 col-sm-6 col-md-3">
        <label asp-for="Type" class="form-label"></label>
        <input asp-for="Type" class="form-control" list="assessment-types" placeholder="e.g. Quiz" />
        <span asp-validation-for="Type" class="text-danger small"></span>
    </div>
    <div class="col-6 col-md-2">
        <label asp-for="MaxScore" class="form-label"></label>
        <input asp-for="MaxScore" type="number" step="0.01" min="0.01" max="9999.99" class="form-control" />
        <span asp-validation-for="MaxScore" class="text-danger small"></span>
    </div>
    <div class="col-6 col-md-2">
        <label asp-for="WeightPercent" class="form-label"></label>
        <input asp-for="WeightPercent" type="number" step="0.01" min="0.01" max="100" class="form-control" />
        <span asp-validation-for="WeightPercent" class="text-danger small"></span>
    </div>
    <div class="col-12 col-md-1 align-self-end">
        <button type="submit" class="btn btn-primary w-100">@(isNew ? "Add" : "Save")</button>
    </div>
</form>

<datalist id="assessment-types">
    @foreach (var type in AssessmentFormViewModel.SuggestedTypes)
    {
        <option value="@type"></option>
    }
</datalist>
