@model SessionResponse
@{
    var css = Model.DisplayStatus switch
    {
        "Open" => "text-bg-success",
        "Scheduled" => "text-bg-primary",
        "Cancelled" => "text-bg-danger",
        _ => "text-bg-secondary" // Ended, Closed, Finalized
    };
}
<span class="badge @css">@Model.DisplayStatus</span>
