@model StartSessionViewModel
@* Form-level errors live under the "start" key (SessionsController.Start), so they never show in the Add assessment form. *@
@{ var formErrors = ViewData.ModelState.TryGetValue("start", out var entry) ? entry.Errors : null; }

<section class="card mb-4" aria-labelledby="start-heading">
    <div class="card-body">
        <h2 id="start-heading" class="h5 card-title">Start a session</h2>
        <p class="text-body-secondary small">It starts now and shows a QR code students scan to check in. Times are Manila time.</p>

        <form asp-controller="Sessions" asp-action="Start" method="post" class="row g-3 align-items-end">
            @if (formErrors is { Count: > 0 })
            {
                <div class="alert alert-danger col-12 mb-0" role="alert">
                    @foreach (var error in formErrors)
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }
            <input type="hidden" asp-for="ClassId" />

            <div class="col-12 col-md-5">
                <label asp-for="EndTime" class="form-label"></label>
                <input asp-for="EndTime" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
                <span asp-validation-for="EndTime" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-4">
                <label asp-for="LateAfterMinutes" class="form-label"></label>
                <input asp-for="LateAfterMinutes" type="number" min="0" max="120" class="form-control" />
                <span asp-validation-for="LateAfterMinutes" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-3">
                <button type="submit" class="btn btn-primary w-100" data-pending-text="Starting…">Start session</button>
            </div>
        </form>
    </div>
</section>
