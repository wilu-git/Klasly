@model List<LinkedStudentResponse>
@{
    ViewData["Title"] = "My children";
}

<h1 class="h3 mb-3">My children</h1>

@if (Model.Count == 0)
{
    <p class="text-body-secondary">No children are linked to your account yet. Ask the school admin.</p>
}
else
{
    <ul class="list-group">
        @foreach (var c in Model)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
                <div>
                    <span class="fw-semibold">@c.StudentName</span>
                    <span class="text-body-secondary small d-block">@c.StudentNumber</span>
                </div>
                <a asp-action="Details" asp-route-id="@c.StudentId" class="btn btn-sm btn-outline-primary"
                   aria-label="Attendance and grades for @c.StudentName">View</a>
            </li>
        }
    </ul>
}
