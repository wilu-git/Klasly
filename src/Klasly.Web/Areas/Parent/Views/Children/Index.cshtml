@model List<LinkedStudentResponse>
@{
    ViewData["Title"] = "My children";
}

<h1 class="h3 mb-4">My children</h1>

@if (Model.Count == 0)
{
    <p class="text-body-secondary">No children are linked to your account yet. Ask the school admin.</p>
}
else
{
    @* The whole row is the link and its text starts with the child's name (WCAG 2.5.3 label in name). *@
    <div class="list-group">
        @foreach (var c in Model)
        {
            <a asp-action="Details" asp-route-id="@c.StudentId"
               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-3 py-3">
                <span>
                    <span class="fw-semibold d-block">@c.StudentName</span>
                    <span class="text-body-secondary small">Student no. @c.StudentNumber</span>
                </span>
                <span class="text-body-secondary small text-end">Attendance and grades</span>
            </a>
        }
    </div>
}
