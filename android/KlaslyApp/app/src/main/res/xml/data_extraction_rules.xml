<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The session file is encrypted with a Keystore key that never leaves the phone,
     so a backed-up or transferred copy could never be read: leave it out (TokenStore). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="klasly_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="klasly_session.xml" />
    </device-transfer>
</data-extraction-rules>
