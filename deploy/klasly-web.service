# Klasly MVC portal. Install: sudo cp deploy/klasly-web.service /etc/systemd/system/ && sudo systemctl enable --now klasly-web
[Unit]
Description=Klasly Web MVC portal
After=network.target klasly-api.service

[Service]
# User klasly needs a home dir: ASP.NET keeps its login-cookie keys in ~/.aspnet, so logins survive restarts.
User=klasly
WorkingDirectory=/opt/klasly/web
ExecStart=/opt/klasly/web/Klasly.Web
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5001
Environment=ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
EnvironmentFile=/etc/klasly/klasly.env
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
