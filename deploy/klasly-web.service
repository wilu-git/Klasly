# Klasly MVC portal, a systemd *user* service of the klasly login user.
# Install: see klasly-api.service, then: systemctl --user enable --now klasly-web
[Unit]
Description=Klasly Web MVC portal
After=network-online.target klasly-api.service

[Service]
# Runs as klasly, whose home holds ~/.aspnet: the login-cookie keys survive restarts.
WorkingDirectory=%h/klasly/web
ExecStart=%h/klasly/web/Klasly.Web
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5001
Environment=ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
EnvironmentFile=%h/klasly/klasly.env
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
