# Copy to ~/klasly/klasly.env on the VPS (as the klasly user), fill in, then: chmod 600 ~/klasly/klasly.env
# Never commit the filled-in file. Read by all three services (API, Web, Worker); each ignores keys it doesn't use.
# Generate the two keys with: openssl rand -base64 48

# API + Worker: Klasly's own SQL Server container, published on 127.0.0.1:14330 only (1433 belongs to another site).
ConnectionStrings__Klasly=Server=127.0.0.1,14330;Database=Klasly;User Id=sa;Password=<sa password>;TrustServerCertificate=True

# API
Jwt__Key=<at least 32 random characters>
Qr__SigningKey=<at least 32 random characters>
Fcm__ServiceAccountPath=/home/klasly/klasly/fcm.json

# Web (MVC calls the API on the same box, not through Caddy)
Api__BaseUrl=http://127.0.0.1:5000/

# Worker
Brevo__ApiKey=<Brevo API key>
Brevo__SenderEmail=<sender address verified in Brevo>
# Every minute for the demo; the default is every 5 minutes (*/5 * * * *). Restart the worker after changing it.
Worker__Cron=* * * * *
